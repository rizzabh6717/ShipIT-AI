# docker compose environment template
# Copy to `.env` (gitignored) and adjust. All values have safe defaults,
# so `docker compose up --build` works out of the box (offline deterministic AI).

# --- PostgreSQL (db service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=shipit
POSTGRES_DB=shipit
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: origins the browser may call the API from (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]

# --- AI (optional; leave empty to run offline deterministic mode) ---
EMBEDDING_PROVIDER=deterministic   # deterministic | openrouter | openai
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

LLM_PROVIDER=heuristic            # heuristic | openrouter | openai
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

AI_MATCH_TOP_K=10
AI_MATCH_MAX_RESULTS=5

# --- Frontend (baked in at build time) ---
# What the browser uses to reach the API. Keep http://localhost:8000/api for
# local Docker; point at your domain for production.
VITE_API_URL=http://localhost:8000/api