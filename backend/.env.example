# Application
APP_NAME="ShipIT API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api"

# Database
DATABASE_URL=""

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "http://127.0.0.1:8080"]

# JWT - CHANGE THIS IN PRODUCTION!
JWT_SECRET_KEY="your-super-secret-jwt-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# Embeddings (OpenRouter) - NVIDIA Nemotron embedding model
EMBEDDING_PROVIDER="openrouter"
EMBEDDING_MODEL="nvidia/llama-nemotron-embed-vl-1b-v2:free"
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=""  # Add your OpenRouter API key here
EMBEDDING_BASE_URL="https://openrouter.ai/api/v1"

# LLM (OpenRouter) - NVIDIA Nemotron 3 Super
LLM_PROVIDER="openrouter"
LLM_MODEL="nvidia/nemotron-3-super-120b-a12b"
LLM_API_KEY=""  # Add your OpenRouter API key here (can be same as embedding)
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_TEMPERATURE=0.0

# AI Matching
AI_MATCH_TOP_K=10
AI_MATCH_MAX_RESULTS=5
